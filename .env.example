# Public HTTPS URL of your Mealie instance (no trailing slash).
# Must start with https:// (or be localhost) or the MCP/OAuth routes are NOT registered.
BASE_URL=https://mealie.example.com

# Change these before first start.
POSTGRES_USER=mealie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mealie

# IP of your reverse proxy (used for per-IP rate limiting). "*" trusts every proxy header.
HOST_IP=*
