{%- comment -%}
  Mealie "Ce soir": full view. Paste into the private plugin's Full markup.
  Data: GET /api/households/trmnl/tonight (polled by TRMNL); every string arrives formatted in French, lists come
  sorted (by kind of food, worst first, …). This template only lays them out.
  Nothing is cut off: text wraps, and the script at the bottom shrinks each column's text until it fits (down to
  12 px). Only past that does a column drop its last lines into "+ N autres".
{%- endcomment -%}
{%- assign all_good = false -%}
{%- if state == "planned" and toBuy.size == 0 and toCheckCount == 0 -%}{%- assign all_good = true -%}{%- endif -%}
{%- assign when = kicker | split: " · " -%}
{%- assign facts = "" | split: "" -%}
{%- if recipe and recipe.facts != "" -%}{%- assign facts = recipe.facts | split: " · " -%}{%- endif -%}
{%- comment -%} `| default: 0`: an older Mealie may send no list, and nil is neither 0 nor more {%- endcomment -%}
{%- assign urgent = useSoon.size | default: 0 -%}
{%- assign place_count = places.size | default: 0 -%}
<style>
  .ms { font-family: "Inter", system-ui, sans-serif; color: #000; }
  /* Each .fit column sets the base size; everything inside is in em, so shrinking it shrinks the whole column. */
  .ms-fit { min-height: 0; overflow: hidden; font-size: 20px; line-height: 1.25; }
  .ms-when { display: flex; align-items: center; gap: .6em; }
  .ms-tab { background: #000; color: #fff; padding: .3em .6em .25em; border-radius: 6px; font-weight: 700; letter-spacing: .04em; }
  .ms-date { font-size: .9em; }
  .ms-name { font-size: 2.3em; line-height: 1.08; font-weight: 600; margin-top: .4em; }
  .ms-facts { display: flex; flex-wrap: wrap; gap: .3em 1.1em; margin-top: .6em; font-size: 1.1em; }
  .ms-photo { flex: 1 1 0; min-height: 0; max-height: 170px; width: 100%; object-fit: cover; border-radius: 8px; margin-top: .7em; }
  .ms-home { margin-top: auto; padding-top: .5em; border-top: 1px solid #000; font-size: .9em; }
  .ms-photo + .ms-home { margin-top: .6em; }
  .ms-head { display: flex; justify-content: space-between; align-items: baseline; gap: .5em; border-bottom: 3px solid #000; padding-bottom: .25em; }
  .ms-head-title { font-size: 1.2em; font-weight: 700; }
  .ms-head-count { font-size: .9em; white-space: nowrap; }
  .ms-head--next { margin-top: .8em; }
  .ms-row { display: flex; align-items: flex-start; gap: .5em; margin-top: .35em; }
  .ms-box { flex: none; width: .85em; height: .85em; border: 2.5px solid #000; border-radius: 3px; margin-top: .15em; }
  .ms-box--dashed { border-style: dashed; }
  .ms-row-name { flex: 1; min-width: 0; }
  .ms-row-sub { display: block; font-size: .75em; }
  .ms-row-qty { white-space: nowrap; font-weight: 600; }
  .ms-more { font-size: .85em; margin-top: .4em; }
  .ms-done { border: 3px solid #000; border-radius: 10px; padding: .8em; display: flex; gap: .7em; align-items: flex-start; }
  .ms-done-mark { flex: none; width: 1.7em; height: 1.7em; background: #000; color: #fff; border-radius: 6px; font-size: 1.3em; line-height: 1.7em; text-align: center; font-weight: 700; }
  .ms-done-title { font-size: 1.4em; font-weight: 700; }
  .ms-done-sub { font-size: .9em; margin-top: .2em; }
  .ms-note { font-size: 1em; margin-top: .8em; }
  /* one line per kind of food: the kind in small caps, then its foods */
  .ms-type { display: grid; grid-template-columns: 6.2em 1fr; gap: .55em; padding: .28em 0; border-bottom: 1px dotted #000; font-size: .95em; }
  .ms-type:last-child { border-bottom: 0; }
  .ms-type-name { font-size: .74em; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding-top: .2em; }
  .ms-q { font-weight: 600; white-space: nowrap; }
  .ms-soon { font-weight: 700; text-decoration: underline; }
  .ms-line { display: flex; align-items: center; gap: .5em; margin-top: .35em; }
  .ms-line-place { font-size: .75em; padding-left: .3em; }
  .ms-tag { flex: none; white-space: nowrap; font-size: .85em; font-weight: 600; padding: 0 .4em; border: 2px solid #000; border-radius: 5px; }
  .ms-tag--past { background: #000; color: #fff; }
  .ms-tag--check { border-style: dashed; }
  .ms-tag--plain { border-color: transparent; padding-left: 0; padding-right: 0; }
  .ms-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1em; padding-bottom: 10px; font-size: 18px; }
  .ms-top-date { font-size: 22px; font-weight: 700; white-space: nowrap; }
  .ms-calm { font-weight: 600; }
</style>

{%- if state == "nothing_planned" -%}
{%- comment -%}
  Left: what to finish soon, then the first place (the fridge when it holds anything). Right: the other places.
  With nothing to finish, the first two places go left. One place and nothing to finish: one full-width column.
{%- endcomment -%}
{%- if urgent > 0 -%}
  {%- if place_count >= 2 -%}{%- assign split = 1 -%}{%- else -%}{%- assign split = 0 -%}{%- endif -%}
{%- else -%}
  {%- if place_count >= 3 -%}{%- assign split = 2 -%}{%- else -%}{%- assign split = 1 -%}{%- endif -%}
{%- endif -%}
{%- assign right_count = place_count | minus: split -%}
<div class="layout layout--top layout--stretch-y ms">
  <div style="width: 100%; display: flex; flex-direction: column; height: 100%;">
    <div class="ms-top">
      <span class="ms-top-date">{{ when[1] | capitalize }}</span>
      <span>{% if urgent == 0 and place_count > 0 %}<span class="ms-calm">✓ Rien à finir en urgence</span> · {% endif %}Aucun repas prévu cette semaine</span>
    </div>
    <div class="columns" style="flex: 1; min-height: 0; align-items: stretch; gap: 0;">
      <div class="column ms-fit" data-fit style="flex: 1; justify-content: flex-start;{% if right_count > 0 %} padding-right: 20px;{% endif %}">
        <div>
        {%- if urgent > 0 -%}
          <div class="ms-head"><span class="ms-head-title">À finir vite</span><span class="ms-head-count">{{ urgent }}</span></div>
          {%- for item in useSoon -%}
            {%- assign tag = "" -%}
            {%- if item.when == "dépassé" -%}{%- assign tag = " ms-tag--past" -%}
            {%- elsif item.when == "à vérifier" -%}{%- assign tag = " ms-tag--check" -%}
            {%- elsif item.when != "aujourd'hui" -%}{%- assign tag = " ms-tag--plain" -%}{%- endif -%}
            <div class="ms-line" data-fit-item="1">
              <span class="ms-row-name">{{ item.name }}{% if item.place != "" and item.place != "Frigo" %}<span class="ms-line-place">{{ item.place | downcase }}</span>{% endif %}</span>
              <span class="ms-tag{{ tag }}">{{ item.when }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}
        {%- if place_count == 0 -%}
          <div class="ms-head{% if urgent > 0 %} ms-head--next{% endif %}"><span class="ms-head-title">Garde-manger</span></div>
          <div class="ms-note">Rien d'enregistré dans le garde-manger de Mealie.</div>
        {%- endif -%}
        {%- for place in places limit: split -%}
          <div class="ms-head{% if urgent > 0 or forloop.index > 1 %} ms-head--next{% endif %}"><span class="ms-head-title">{{ place.name }}</span><span class="ms-head-count">{{ place.count }}</span></div>
          {%- if place.groups.size > 0 -%}
            {%- for group in place.groups -%}
              <div class="ms-type" data-fit-item="{{ group.items.size }}"><span class="ms-type-name">{{ group.name }}</span><span>{% for line in group.items %}{{ line.name }} <span class="ms-q">{{ line.quantity }}</span>{% unless forloop.last %} · {% endunless %}{% endfor %}</span></div>
            {%- endfor -%}
          {%- else -%}
            <div class="ms-note" style="margin-top: .35em;">{{ place.items | join: ", " }}</div>
          {%- endif -%}
        {%- endfor -%}
        </div>
      </div>
      {%- if right_count > 0 -%}
      <div class="column ms-fit" data-fit style="flex: 1; justify-content: flex-start; border-left: 3px solid #000; padding-left: 20px;">
        <div>
        {%- for place in places offset: split -%}
          <div class="ms-head{% if forloop.index > 1 %} ms-head--next{% endif %}"><span class="ms-head-title">{{ place.name }}</span><span class="ms-head-count">{{ place.count }}</span></div>
          {%- if place.groups.size > 0 -%}
            {%- for group in place.groups -%}
              <div class="ms-type" data-fit-item="{{ group.items.size }}"><span class="ms-type-name">{{ group.name }}</span><span>{% for line in group.items %}{{ line.name }} <span class="ms-q">{{ line.quantity }}</span>{% unless forloop.last %} · {% endunless %}{% endfor %}</span></div>
            {%- endfor -%}
          {%- else -%}
            <div class="ms-note" style="margin-top: .35em;">{{ place.items | join: ", " }}</div>
          {%- endif -%}
        {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- else -%}
<div class="layout layout--top layout--stretch-y ms">
  <div class="columns" style="height: 100%; align-items: stretch; gap: 0;">

    <div class="column ms-fit" data-fit style="flex: 54; justify-content: flex-start; padding-right: 22px; display: flex; flex-direction: column;">
      <div class="ms-when">
        <span class="ms-tab">{{ when[0] }}</span>
        <span class="ms-date">{{ when[1] | capitalize }}</span>
      </div>
      <span class="ms-name">{{ recipe.name }}</span>
      {%- if facts.size > 0 -%}
        <div class="ms-facts">{%- for fact in facts -%}<span>{{ fact }}</span>{%- endfor -%}</div>
      {%- endif -%}
      {%- if state == "no_recipe" -%}
        <div class="ms-note">Pas de recette liée dans le planning.</div>
      {%- endif -%}
      {%- if recipe.imageUrl -%}
        <img class="image image-dither ms-photo" src="{{ recipe.imageUrl }}" alt="" data-fit-photo>
      {%- endif -%}
      {%- if state == "planned" and all_good == false and atHome.size > 0 -%}
        <div class="ms-home">Déjà là :
          {% for item in atHome -%}
            {%- if item.useSoon -%}<span class="ms-soon">{{ item.name }}</span>{%- else -%}{{ item.name }}{%- endif -%}
            {%- unless forloop.last -%}, {% endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="column ms-fit" data-fit style="flex: 46; justify-content: flex-start; border-left: 3px solid #000; padding-left: 22px;">
      <div>
      {%- if state == "no_recipe" -%}
        {%- if urgent > 0 -%}
          <div class="ms-head"><span class="ms-head-title">À finir vite</span><span class="ms-head-count">{{ urgent }}</span></div>
          {%- for item in useSoon -%}
            {%- assign tag = "" -%}
            {%- if item.when == "dépassé" -%}{%- assign tag = " ms-tag--past" -%}
            {%- elsif item.when == "à vérifier" -%}{%- assign tag = " ms-tag--check" -%}
            {%- elsif item.when != "aujourd'hui" -%}{%- assign tag = " ms-tag--plain" -%}{%- endif -%}
            <div class="ms-line" data-fit-item="1">
              <span class="ms-row-name">{{ item.name }}{% if item.place != "" and item.place != "Frigo" %}<span class="ms-line-place">{{ item.place | downcase }}</span>{% endif %}</span>
              <span class="ms-tag{{ tag }}">{{ item.when }}</span>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="ms-done"><span class="ms-done-mark">✓</span><div><div class="ms-done-title">Rien à finir</div><div class="ms-done-sub">Rien ne presse dans le garde-manger.</div></div></div>
        {%- endif -%}

      {%- elsif all_good -%}
        <div class="ms-done">
          <span class="ms-done-mark">✓</span>
          <div>
            <div class="ms-done-title">Rien à acheter</div>
            <div class="ms-done-sub">Les {{ ingredientCount }} ingrédients sont à la maison.</div>
          </div>
        </div>
        {%- if atHome.size > 0 -%}
          <div class="ms-head ms-head--next"><span class="ms-head-title">À sortir</span><span class="ms-head-count">{{ atHome.size }}</span></div>
          {%- comment -%} the list comes sorted by kind: a new line each time the kind changes {%- endcomment -%}
          {%- assign previous = nil -%}
          {%- for item in atHome -%}
            {%- if forloop.first or item.type != previous -%}
              {%- unless forloop.first -%}</span></div>{%- endunless -%}
              <div class="ms-type" data-fit-item="1"><span class="ms-type-name">{{ item.type }}</span><span>
              {%- assign previous = item.type -%}
            {%- else %} · {% endif -%}
            {%- if item.useSoon -%}<span class="ms-soon">{{ item.name }}</span>{%- else -%}{{ item.name }}{%- endif -%}
            {%- if forloop.last -%}</span></div>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}

      {%- else -%}
        <div class="ms-head">
          <span class="ms-head-title">À acheter</span>
          <span class="ms-head-count">{{ toBuy.size | plus: toBuyMore }} sur {{ ingredientCount }}</span>
        </div>
        {%- for item in toBuy -%}
          <div class="ms-row" data-fit-item="1">
            <span class="ms-box{% if item.onList %} ms-box--dashed{% endif %}"></span>
            <span class="ms-row-name">{{ item.name }}
              {%- if item.left or item.onList -%}
                <span class="ms-row-sub">{% if item.left %}{{ item.left }}{% endif %}{% if item.left and item.onList %}, {% endif %}{% if item.onList %}déjà sur la liste{% endif %}</span>
              {%- endif -%}
            </span>
            {%- if item.quantity -%}<span class="ms-row-qty">{{ item.quantity }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
        {%- if toBuyMore > 0 or toCheckCount > 0 -%}
          <div class="ms-more" style="padding-left: 1.35em;">
            {%- if toBuyMore > 0 -%}+ {{ toBuyMore }} autres{%- endif -%}
            {%- if toBuyMore > 0 and toCheckCount > 0 -%}, {% endif -%}
            {%- if toCheckCount > 0 -%}{% if toBuyMore == 0 %}+ {% endif %}{{ toCheckCount }} à vérifier dans la recette{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
      </div>
    </div>

  </div>
</div>
{%- endif -%}

<div class="title_bar">
  <span class="title">Mealie</span>
  <span class="instance">mis à jour {{ generatedAt }}</span>
</div>

<script>
  // Fit each column: shrink its text half a pixel at a time until it fits, down to 12 px. If it still overflows,
  // drop its last lines one by one and say how many foods were left out. A photo too squeezed to read is dropped.
  (function () {
    var MIN = 12;
    function fits(el) { return el.scrollHeight <= el.clientHeight + 1; }
    function fit() {
      document.querySelectorAll("[data-fit]").forEach(function (col) {
        // start over, so running again once the fonts are in gives the same result as a first run
        col.style.fontSize = "";
        col.querySelectorAll("[data-fit-more]").forEach(function (el) { el.remove(); });
        col.querySelectorAll("[data-fit-item], [data-fit-photo]").forEach(function (el) { el.style.display = ""; });
        var size = parseFloat(getComputedStyle(col).fontSize) || 20;
        while (!fits(col) && size > MIN) {
          size -= 0.5;
          col.style.fontSize = size + "px";
        }
        var photo = col.querySelector("[data-fit-photo]");
        if (photo && photo.getBoundingClientRect().height < 50) { photo.style.display = "none"; }
        if (fits(col)) { return; }
        var items = col.querySelectorAll("[data-fit-item]");
        var more = document.createElement("div");
        more.className = "ms-more";
        more.setAttribute("data-fit-more", "");
        (col.firstElementChild && col.children.length === 1 ? col.firstElementChild : col).appendChild(more);
        var left = 0;
        for (var i = items.length - 1; i >= 0 && !fits(col); i--) {
          items[i].style.display = "none";
          left += parseInt(items[i].getAttribute("data-fit-item"), 10) || 1;
          more.textContent = "+ " + left + " autre" + (left > 1 ? "s" : "");
        }
      });
    }
    fit();
    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(fit); }
  })();
</script>
