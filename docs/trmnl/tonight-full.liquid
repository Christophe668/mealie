{%- comment -%}
  Mealie "Ce soir": full view. Paste into the private plugin's Full markup.
  Data: GET /api/households/trmnl/tonight (polled by TRMNL); every string arrives formatted in French.
  This template only shows and hides blocks. Keep the logic in Mealie.
  Two screens: the next meal and what to buy; or, when nothing is planned this week, the pantry ("À la maison").
{%- endcomment -%}
{%- assign to_buy_rows = toBuy.size | plus: toBuyMore -%}
{%- assign all_good = false -%}
{%- if state == "planned" and toBuy.size == 0 and toCheckCount == 0 -%}{%- assign all_good = true -%}{%- endif -%}
{%- assign when = kicker | split: " · " -%}
{%- assign facts = "" | split: "" -%}
{%- if recipe and recipe.facts != "" -%}{%- assign facts = recipe.facts | split: " · " -%}{%- endif -%}
<style>
  .ms { font-family: "Inter", system-ui, sans-serif; }
  .ms-when { display: flex; align-items: center; gap: 12px; }
  .ms-tab { background: #000; color: #fff; padding: 6px 12px 5px; border-radius: 6px; font-weight: 700; font-size: 20px; letter-spacing: .04em; }
  .ms-date { font-size: 18px; }
  .ms-name { font-size: 46px; line-height: 1.08; font-weight: 600; margin-top: 18px; }
  .ms-facts { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 14px; font-size: 22px; }
  .ms-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 3px solid #000; padding-bottom: 6px; }
  .ms-head-title { font-size: 24px; font-weight: 700; }
  .ms-head-count { font-size: 20px; }
  .ms-row { display: flex; align-items: flex-start; gap: 10px; margin-top: 7px; font-size: 20px; line-height: 1.15; }
  .ms-box { flex: none; width: 17px; height: 17px; border: 2.5px solid #000; border-radius: 3px; margin-top: 2px; }
  .ms-box--dashed { border-style: dashed; }
  .ms-row-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ms-row-sub { display: block; font-size: 15px; }
  .ms-row-qty { white-space: nowrap; font-weight: 600; }
  .ms-more { font-size: 17px; margin-top: 8px; padding-left: 27px; }
  .ms-photo { flex: 1 1 0; min-height: 60px; max-height: 170px; width: 100%; object-fit: cover; border-radius: 8px; margin-top: 14px; }
  .ms-home { margin-top: auto; padding-top: 10px; border-top: 1px solid #000; font-size: 18px; line-height: 1.3; }
  .ms-photo + .ms-home { margin-top: 12px; }
  .ms-home b { font-weight: 700; text-decoration: underline; }
  .ms-done { border: 3px solid #000; border-radius: 10px; padding: 18px; display: flex; gap: 14px; align-items: flex-start; }
  .ms-done-mark { flex: none; width: 34px; height: 34px; background: #000; color: #fff; border-radius: 6px; font-size: 26px; line-height: 34px; text-align: center; font-weight: 700; }
  .ms-done-title { font-size: 28px; font-weight: 700; }
  .ms-done-sub { font-size: 18px; margin-top: 4px; }
  /* pantry screen: adapts to what there is. Nothing urgent: the pantry takes the full width. */
  .ms-top { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; font-size: 18px; }
  .ms-top-date { font-size: 22px; font-weight: 700; }
  .ms-tag { flex: none; white-space: nowrap; font-size: 17px; font-weight: 600; padding: 1px 8px; border: 2px solid #000; border-radius: 5px; }
  .ms-tag--past { background: #000; color: #fff; }
  .ms-tag--check { border-style: dashed; }
  .ms-tag--plain { border-color: transparent; padding-left: 0; padding-right: 0; }
  .ms-place-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #000; padding-bottom: 3px; }
  .ms-place-name { font-size: 20px; font-weight: 700; }
  .ms-place-count { font-size: 17px; }
  .ms-place--main .ms-place-name { font-size: 24px; }
  .ms-place--main .ms-place-head { border-bottom-width: 3px; padding-bottom: 6px; }
  .ms-grid { display: grid; column-gap: 16px; font-size: 19px; }
  .ms-grid span { height: 32px; line-height: 32px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* one row height on both sides, so the urgent list and the pantry grid line up */
  .ms-line { display: flex; align-items: center; gap: 10px; height: 32px; font-size: 19px; }
  .ms-line-place { font-size: 15px; padding-left: 6px; }
  .ms-head + .ms-line, .ms-place-head + .ms-grid { margin-top: 6px; }
  .ms-grid .ms-grid-more { font-size: 17px; }
  .ms-others { display: flex; gap: 22px; margin-top: 16px; }
  .ms-others > div { flex: 1; min-width: 0; }
  .ms-others--stack { flex-direction: column; gap: 14px; }
  .ms-place-line { font-size: 18px; margin-top: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ms-calm { font-size: 18px; font-weight: 600; }
</style>

{%- if state == "nothing_planned" -%}
{%- comment -%}
  Two arrangements. With items to finish: they on the left, the pantry on the right. Without: the pantry alone,
  full width. The first place (the fridge when it holds anything) gets a grid sized to the room left by the others.
{%- endcomment -%}
{%- comment -%} `| default: 0`: an older Mealie sends no `places`, and nil is neither 0 nor more {%- endcomment -%}
{%- assign urgent = useSoon.size | default: 0 -%}
{%- assign place_count = places.size | default: 0 -%}
{%- assign others = place_count | minus: 1 -%}
{%- if urgent > 0 -%}
  {%- assign cols = 2 -%}
  {%- if others <= 0 -%}{%- assign rows = 10 -%}{%- elsif others == 1 -%}{%- assign rows = 7 -%}{%- else -%}{%- assign rows = 5 -%}{%- endif -%}
{%- else -%}
  {%- assign cols = 3 -%}
  {%- if others <= 0 -%}{%- assign rows = 10 -%}{%- else -%}{%- assign rows = 5 -%}{%- endif -%}
{%- endif -%}
<div class="layout layout--top layout--stretch-y ms">
  <div style="width: 100%; display: flex; flex-direction: column; height: 100%;">
    <div class="ms-top">
      <span class="ms-top-date">{{ when[1] | capitalize }}</span>
      <span>{% if urgent == 0 and place_count > 0 %}<span class="ms-calm">✓ Rien à finir en urgence</span> · {% endif %}Aucun repas prévu cette semaine</span>
    </div>

    <div class="columns" style="flex: 1; align-items: stretch; gap: 0;">
      {%- if urgent > 0 -%}
      <div class="column" style="flex: 45; justify-content: flex-start; padding-right: 22px; overflow: hidden;">
        <div>
        <div class="ms-head"><span class="ms-head-title">À finir vite</span><span class="ms-head-count">{{ urgent }}</span></div>
        {%- for item in useSoon -%}
          {%- assign tag = "" -%}
          {%- if item.when == "dépassé" -%}{%- assign tag = " ms-tag--past" -%}
          {%- elsif item.when == "à vérifier" -%}{%- assign tag = " ms-tag--check" -%}
          {%- elsif item.when != "aujourd'hui" -%}{%- assign tag = " ms-tag--plain" -%}{%- endif -%}
          <div class="ms-line">
            <span class="ms-row-name">{{ item.name }}{% if item.place != "" and item.place != "Frigo" %}<span class="ms-line-place">{{ item.place | downcase }}</span>{% endif %}</span>
            <span class="ms-tag{{ tag }}">{{ item.when }}</span>
          </div>
        {%- endfor -%}
        </div>
      </div>
      {%- endif -%}

      <div class="column" style="flex: 55; justify-content: flex-start; overflow: hidden;{% if urgent > 0 %} border-left: 3px solid #000; padding-left: 22px;{% endif %}">
        <div>
        {%- if place_count == 0 -%}
          <div class="ms-head"><span class="ms-head-title">Garde-manger</span></div>
          <div class="ms-row">Rien d'enregistré dans le garde-manger de Mealie.</div>
        {%- else -%}
          {%- assign main = places | first -%}
          {%- assign room = rows | times: cols -%}
          {%- if main.count > room -%}{%- assign shown = room | minus: 1 -%}{%- else -%}{%- assign shown = room -%}{%- endif -%}
          {%- assign rest = main.count | minus: shown -%}
          <div class="ms-place--main">
            <div class="ms-place-head"><span class="ms-place-name">{{ main.name }}</span><span class="ms-place-count">{{ main.count }}</span></div>
            <div class="ms-grid" style="grid-template-columns: repeat({{ cols }}, 1fr);">
              {%- for name in main.items limit: shown -%}<span>{{ name }}</span>{%- endfor -%}
              {%- if rest > 0 -%}<span class="ms-grid-more">+ {{ rest }} autres</span>{%- endif -%}
            </div>
          </div>
          {%- if others > 0 -%}
            {%- comment -%} beside the urgent list: one line per place; full width: side by side, a short list each {%- endcomment -%}
            <div class="ms-others{% if urgent > 0 %} ms-others--stack{% endif %}">
              {%- for place in places offset: 1 -%}
                <div>
                  <div class="ms-place-head"><span class="ms-place-name">{{ place.name }}</span><span class="ms-place-count">{{ place.count }}</span></div>
                  {%- if urgent > 0 -%}
                    <div class="ms-place-line">{{ place.items | join: ", " }}</div>
                  {%- else -%}
                    {%- if place.count > 3 -%}{%- assign few = 2 -%}{%- else -%}{%- assign few = 3 -%}{%- endif -%}
                    {%- assign left = place.count | minus: few -%}
                    <div class="ms-grid" style="grid-template-columns: 1fr;">
                      {%- for name in place.items limit: few -%}<span>{{ name }}</span>{%- endfor -%}
                      {%- if left > 0 -%}<span class="ms-grid-more">+ {{ left }} autres</span>{%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- else -%}
<div class="layout layout--top layout--stretch-y ms">
  <div class="columns" style="height: 100%; align-items: stretch; gap: 0;">

    <div class="column" style="flex: 54; justify-content: flex-start; padding-right: 22px;">
      <div class="ms-when">
        <span class="ms-tab">{{ when[0] }}</span>
        <span class="ms-date">{{ when[1] | capitalize }}</span>
      </div>
      <span class="ms-name" data-clamp="3">{{ recipe.name }}</span>
      {%- if facts.size > 0 -%}
        <div class="ms-facts">{%- for fact in facts -%}<span>{{ fact }}</span>{%- endfor -%}</div>
      {%- endif -%}
      {%- comment -%} a three-line name leaves only a sliver for the photo: leave it out {%- endcomment -%}
      {%- if recipe.imageUrl and recipe.name.size <= 30 -%}
        <img class="image image-dither ms-photo" src="{{ recipe.imageUrl }}" alt="">
      {%- endif -%}
      {%- if state == "planned" and all_good == false and atHome.size > 0 -%}
        <div class="ms-home" data-clamp="3">Déjà là :
          {% for item in atHome -%}
            {%- if item.useSoon -%}<b>{{ item.name }}</b>{%- else -%}{{ item.name }}{%- endif -%}
            {%- unless forloop.last -%}, {% endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="column" style="flex: 46; justify-content: flex-start; border-left: 3px solid #000; padding-left: 22px; overflow: hidden;">
      {%- if state == "no_recipe" -%}
        <div class="ms-head"><span class="ms-head-title">À acheter</span></div>
        <div class="ms-row">Pas de recette liée à ce repas : la liste ne peut pas être calculée.</div>
        <div class="ms-more" style="padding-left: 0;">Lie une recette à ce repas dans le planning Mealie.</div>

      {%- elsif all_good -%}
        <div class="ms-done">
          <span class="ms-done-mark">✓</span>
          <div>
            <div class="ms-done-title">Rien à acheter</div>
            <div class="ms-done-sub">Les {{ ingredientCount }} ingrédients sont à la maison.</div>
          </div>
        </div>
        {%- if atHome.size > 0 -%}
          <div class="ms-head" style="margin-top: 18px;"><span class="ms-head-title">À sortir</span></div>
          {%- for item in atHome limit: 8 -%}
            <div class="ms-row"><span class="ms-row-name">{% if item.useSoon %}<b>{{ item.name }}</b>{% else %}{{ item.name }}{% endif %}</span></div>
          {%- endfor -%}
        {%- endif -%}

      {%- else -%}
        <div class="ms-head">
          <span class="ms-head-title">À acheter</span>
          <span class="ms-head-count">{{ to_buy_rows }} sur {{ ingredientCount }}</span>
        </div>
        {%- for item in toBuy -%}
          <div class="ms-row">
            <span class="ms-box{% if item.onList %} ms-box--dashed{% endif %}"></span>
            <span class="ms-row-name">{{ item.name }}
              {%- if item.left or item.onList -%}
                <span class="ms-row-sub">{% if item.left %}{{ item.left }}{% endif %}{% if item.left and item.onList %}, {% endif %}{% if item.onList %}déjà sur la liste{% endif %}</span>
              {%- endif -%}
            </span>
            {%- if item.quantity -%}<span class="ms-row-qty">{{ item.quantity }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
        {%- if toBuyMore > 0 or toCheckCount > 0 -%}
          <div class="ms-more">
            {%- if toBuyMore > 0 -%}+ {{ toBuyMore }} autres{%- endif -%}
            {%- if toBuyMore > 0 and toCheckCount > 0 -%}, {% endif -%}
            {%- if toCheckCount > 0 -%}{% if toBuyMore == 0 %}+ {% endif %}{{ toCheckCount }} à vérifier dans la recette{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

  </div>
</div>
{%- endif -%}

<div class="title_bar">
  <span class="title">Mealie</span>
  <span class="instance">mis à jour {{ generatedAt }}</span>
</div>
